# Copy to .env and adjust. Never commit .env.
# The backend reads these variables from the process environment
# (see README for how to load them, e.g. `set -a; source .env; set +a`).

# --- Application ---
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Neo4j ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Must match the output dimension of OLLAMA_EMBED_MODEL (nomic-embed-text = 768).
# Only used when the vector index is created in a later stage.
OLLAMA_EMBED_DIMENSIONS=768

# --- Paths (relative to backend/) ---
MIGRATIONS_DIR=../neo4j/migrations
SEED_FILE=../data/seed/financial_network.json

# --- Admin (local development only) ---
# POST /api/admin/seed is only registered when enabled AND APP_ENV != production.
ADMIN_SEED_ENABLED=true
# Required when ADMIN_SEED_ENABLED=true, minimum 16 characters. Sent as X-Admin-Token.
ADMIN_TOKEN=replace-with-a-long-random-string

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_DEFAULT_ENTITY_ID=per_001
